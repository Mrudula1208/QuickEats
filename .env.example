# QuickEats environment configuration
# Copy required values into your hosting environment (never commit real secrets).

# Backend (ASP.NET API)
# JWT signing key - at least 32 characters.
# Local development: dotnet user-secrets set "Jwt:Key" "<your-key>"
# Production: set this environment variable.
Jwt__Key=change-me-to-a-long-random-secret-key

# Frontend (Angular)
# Backend API base URL used by services (e.g. https://localhost:7278/api)
NG_APP_API_URL=
