# QuickEats environment configuration
# Copy required values into your hosting environment (never commit real secrets).

# Backend (ASP.NET API)
# JWT signing key - at least 32 characters.
# Local development: dotnet user-secrets set "Jwt:Key" "<your-key>"
# Production: set this environment variable.
Jwt__Key=change-me-to-a-long-random-secret-key

# SQL Server connection string used in production
# (overrides the value in appsettings.json).
ConnectionStrings__DefaultConnection=Server=<host>;Database=QuickEatsDb;User Id=<user>;Password=<password>;MultipleActiveResultSets=true;TrustServerCertificate=True

# Browser origins allowed by CORS. Set one variable per origin:
# Cors__AllowedOrigins__0=https://your-frontend-domain.com

# Frontend (Angular)
# Backend API base URL used by services.
# Development: https://localhost:7278/api (src/environments/environment.ts)
# Production: set the deployed API base URL in src/environments/environment.prod.ts
NG_APP_API_URL=/api
